# ─── Dependencies & caches ─────────────────────────────────────────────────
node_modules/
__pycache__/
*.pyc
*.pyo
.hypothesis/
.gitnexus/
.embeddings/
.next/
# Anchored: tests/coverage/thresholds.json is checked-in config, not a report.
/coverage/

# ─── Secrets & local config ────────────────────────────────────────────────
.env
.env.*
.daiharness/settings.env

# ─── Machine-local runtime state ───────────────────────────────────────────
# Generated per-run and per-machine. Committing these also breaks the runtime
# lease check, which asserts no runtime state is tracked.
.daiharness/verify/
.daiharness/runtime/
.daiharness/escalations/
.daiharness/pipeline-state.json
.daiharness/leases.json
.daiharness/memory.db*
memory.db
.daiharness/logs/
.daiharness/audit/
.daiharness/metrics/
.daiharness/telemetry/
.daiharness/cache/
.daiharness/local-ci-venv/
.daiharness/mcp-server/node_modules/

# ─── Generated evidence & report artifacts ─────────────────────────────────
.daiharness/reports/
.daiharness/docs-hub/
.daiharness/guardrail-log.jsonl
.daiharness/policy-log.jsonl
.daiharness/rule-ledger.jsonl
.daiharness/quality-history.json
.daiharness/quality-gate-events.jsonl
.daiharness/verification-events.jsonl
.daiharness/quality-report-*.json
.daiharness/baseline-*.json
.daiharness/change-manifest-*.json
.daiharness/git-baseline.json
.daiharness/session-log.json
.daiharness/events.log
.daiharness/bookkeep.log
ruff_errors.json

# Workspace-local MCP runtime evidence
mcp/.daiharness/

# ─── Parallel dispatch worktrees ───────────────────────────────────────────
.worktrees/

# ─── Mutation-testing scratch ──────────────────────────────────────────────
.stryker-tmp/
mutants/
.mutmut-cache

# ─── Editor / tool scratch ─────────────────────────────────────────────────
.qoder/
_local_tmp_edits/

# NOTE on deliberate inclusions:
#   src/cli/dist/       tracked — the docs-continuity gate runs the built CLI
#   .claude/            tracked — tests/unit_tests/test_hook_schema.py reads the
#                       checked-in settings.json
#   *.xlsx              NOT ignored — skills/project-manager/excel-generator
#                       ships real spreadsheet templates

# Local memory store (binary, machine-specific)
.memory/
