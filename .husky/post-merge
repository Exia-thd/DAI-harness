#!/bin/sh
# ⚡ Tự động đồng bộ MCP Global khi phát hiện thay đổi trong thư mục mcp/ sau khi merge/pull
if git diff-tree --no-commit-id --name-only -r ORIG_HEAD HEAD | grep -q '^mcp/'; then
  echo "⚡ [DAI Nexus] Phát hiện thay đổi trong MCP từ nhánh nguồn. Đang tự động đồng bộ MCP Global..."
  if [ -f "./scripts/dai-nexus-mcp-setup.sh" ]; then
    bash ./scripts/dai-nexus-mcp-setup.sh
  else
    # The script this branch was written for is not in the repository. Saying so
    # is the point: a hook that detects a change and then does nothing quietly
    # is indistinguishable from one that worked.
    echo "[DAI Nexus] mcp/ changed, but scripts/dai-nexus-mcp-setup.sh is not in this repository -- MCP Global was not synced."
  fi
fi

# ⚡ Tự động cập nhật submodule
if [ -x "./scripts/lite/submodule-auto-update.sh" ]; then
  ./scripts/lite/submodule-auto-update.sh
fi
