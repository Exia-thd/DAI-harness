# Shell scripts must check out with LF on every platform. With core.autocrlf=true
# a Windows clone rewrites them to CRLF, which shellcheck rejects outright
# (SC1017) and which breaks the scripts under bash at runtime.
*.sh text eol=lf
*.bash text eol=lf
.husky/* text eol=lf
.shellcheckrc text eol=lf

# esbuild writes LF. Without this, core.autocrlf keeps trying to convert the
# committed bundle and leaves it permanently reported as modified.
src/cli/dist/** text eol=lf

# The reference graph is a 12MB frozen snapshot, not a source file. Pinning it
# keeps core.autocrlf from rewriting every record on checkout and reporting the
# whole snapshot as permanently modified, the same reason src/cli/dist is pinned.
src/codegraph/reference/snapshot/** text eol=lf

# Digest-bound fixtures, templates and the pinned discovery catalog. Each of
# these is referenced by a SHA-256 taken over its LF form, so a CRLF checkout
# fails the integrity check on a file nobody edited. core.autocrlf is true on
# this machine, which is exactly the conversion -text switches off.
.daiharness/re-discovery-catalog.json -text
templates/game/ui-kit/** -text
tests/game/fixtures/phaser4-lifecycle/** -text
tests/game/fixtures/threejs-lifecycle/** -text
