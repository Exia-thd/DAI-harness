// The DAI memory CLI. DAI_MEMORY_ENGINE names its install directory; otherwise
// the harness resolver is asked, from the project or from a dai-harness
// submodule inside it.
function memoryCli(): string | null {
  const candidates: string[] = [];
  if (process.env.DAI_MEMORY_ENGINE) candidates.push(process.env.DAI_MEMORY_ENGINE);
  for (const base of [PROJECT_ROOT, join(PROJECT_ROOT, "dai-harness")]) {
    const resolver = join(base, "scripts", "lite", "dai_memory.py");
    if (!existsSync(resolver)) continue;
    for (const [command, ...prefix] of [["py", "-3"], ["python3"], ["python"]]) {
      try {
        candidates.push(
          execFileSync(command, [...prefix, resolver, "where"], { encoding: "utf8" }).trim(),
        );
        break;
      } catch {
        // not this interpreter, or not installed: try the next
      }
    }
  }
  for (const engine of candidates) {
    const cli = join(engine, "bin", "dai-memory.mjs");
    if (existsSync(cli)) return cli;
  }
  return null;
}

// One CLI call. Arguments are passed as a list, never through a shell, so a
// query containing quotes or `;` is a query and nothing else.
function runMemory(args: string[]): string {
  const cli = memoryCli();
  if (!cli) return "Error: the DAI memory engine is not installed (python3 scripts/lite/dai_memory.py install)";
  try {
    return execFileSync("node", [cli, ...args], { cwd: PROJECT_ROOT, encoding: "utf8" });
  } catch (error: any) {
    return `Error: ${error.message}\nStdout: ${error.stdout || ""}\nStderr: ${error.stderr || ""}`;
  }
}

server.setRequestHandler(CallToolRequestSchema, async (request) => {
  const { name, arguments: args } = request.params;
  
  if (name === "project_query") {
    const res = runMemory(["query", String(args?.query ?? "")]);
    return { content: [{ type: "text", text: res }] };
  }
  if (name === "project_context") {
    const res = runMemory(["context", String(args?.name ?? "")]);
    return { content: [{ type: "text", text: res }] };
  }
  if (name === "project_impact") {
    const res = runMemory(["impact", String(args?.target ?? "")]);
    return { content: [{ type: "text", text: res }] };
  }
  
  throw new Error(`Tool not found: ${name}`);
});

async function main() {
  const transport = new StdioServerTransport();
  await server.connect(transport);
  console.error("[{{projectName}} MCP] Started");
}

main().catch(console.error);
